{
  "name": "@ksefuj/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Client-side PDF visualisation of KSeF FA(3) invoices (adapter around a vendored copy of CIRFMF/ksef-pdf-generator)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage --run",
    "gen:fonts": "node scripts/gen-fonts.mjs",
    "gen:notices": "node scripts/gen-notices.mjs",
    "size": "node scripts/size.mjs"
  },
  "author": "ksefuj contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksefuj/ksefuj.git",
    "directory": "packages/pdf"
  },
  "dependencies": {
    "i18next": "25.8.4",
    "pdfmake": "0.3.11",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/pdfmake": "^0.3.2",
    "pdfjs-dist": "4.10.38",
    "typescript": "^5.7.0",
    "vite": "^7.0.6"
  }
}
